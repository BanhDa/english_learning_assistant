# API key từ https://console.anthropic.com (dùng chung cho mọi bot)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Mỗi người một bot Telegram. Tạo từng bot với @BotFather để lấy token.
# BOTn_USER_IDS là ID Telegram của người dùng bot đó (chỉ người này dùng được).
# Chưa biết ID: để trống, chạy bot rồi nhắn /start cho bot đó, bot sẽ trả lại ID.
# Khi đến giờ nhắc học, mỗi bot gửi nhắc cho người của nó. Muốn thêm người, thêm BOT3_*, BOT4_*...
# ---------------------------------------------------------------------------
BOT1_NAME=Tuan
BOT1_TOKEN=
BOT1_USER_IDS=

BOT2_NAME=Vo
BOT2_TOKEN=
BOT2_USER_IDS=

# (Cách cũ, chỉ một bot: bỏ BOT1_*, BOT2_* và dùng hai dòng dưới)
# TELEGRAM_BOT_TOKEN=
# ALLOWED_USER_IDS=

# Model Claude (haiku rẻ và nhanh; đổi sang claude-sonnet-4-5 nếu muốn chất lượng cao hơn)
CLAUDE_MODEL=claude-haiku-4-5

# Giới hạn số lần gọi Claude mỗi người mỗi ngày (chống chi phí bất ngờ)
MAX_LLM_CALLS_PER_DAY=150

# Đường dẫn file dữ liệu SQLite (dùng chung cho mọi bot, dữ liệu tách theo ID người dùng)
DB_PATH=data/study.db

# Giáo án theo tuần và thư mục danh sách từ tùy chọn (xem README)
CURRICULUM_PATH=curriculum.toml
WORDLIST_DIR=wordlists
